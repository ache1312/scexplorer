            "example_zebrafish": "zebrafish"
        };
        const datasetLinks = {
            "example_human": "https://support.10xgenomics.com/single-cell-gene-expression/datasets/1.1.0/pbmc3k",
            "example_mouse": "https://www.10xgenomics.com/datasets/5-k-mouse-e-18-combined-cortex-hippocampus-and-subventricular-zone-cells-3-1-standard-6-0-0",
            "example_zebrafish": "https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE178969" 
        };

