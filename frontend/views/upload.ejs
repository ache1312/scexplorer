        document.getElementById('exportBtn').addEventListener('click', function () {
            const exportOptions = document.getElementById('exportOptionsPre');
            exportOptions.style.display = exportOptions.style.display === 'none' ? 'block' : 'none';

            exportOptions.innerHTML = '';

            const options = [
                { name: 'Export for Seurat', action: exportForSeurat },
                { name: 'Export for Scanpy', action: exportForScanpy }
            ];

            const ul = document.createElement('ul');
            ul.style.cssText = 'list-style: none; margin: 0; padding: 8px 0;';
            options.forEach(opt => {
                const li = document.createElement('li');
                li.textContent = opt.name;
                li.style.cssText = 'padding: 8px 16px; cursor: pointer; color: #374151; font-size: 0.9rem; border-bottom: 1px solid #f3f4f6;';
                li.addEventListener('mouseenter', function() {
                    this.style.backgroundColor = '#f9fafb';
                });
                li.addEventListener('mouseleave', function() {
                    this.style.backgroundColor = 'transparent';
                });
                li.addEventListener('click', function () {
                    opt.action();
                    exportOptions.style.display = 'none';
                });
                ul.appendChild(li);
            });

            exportOptions.appendChild(ul);
        });

        function exportForSeurat() {
            const uuid = sessionStorage.getItem("uuid");
            if (!uuid) {
                console.error("UUID not found in session storage.");
                return;
            }
            showLoadingOverlay('Exporting for Seurat...');

            const url = `${BASE_URL}/seurat_export?uuid=${uuid}`;
            const options = {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ uuid: uuid })
            };

            fetch(url, options)
                .then(response => {
                    if (!response.ok) throw new Error('Failed to export file');
                    return response.blob();
                })
                .then(blob => {
                    const downloadUrl = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = downloadUrl;
                    a.download = `${uuid}.rds`;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    window.URL.revokeObjectURL(downloadUrl);
                    hideLoadingOverlay();

                })
                .catch(error => {
                    console.error("Error during file export:", error);
                    hideLoadingOverlay();
                });
        }

        function exportForScanpy() {
            const uuid = sessionStorage.getItem("uuid");
            if (!uuid) {
                console.error("UUID not found in session storage.");
                return;
            }
            showLoadingOverlay('Exporting for Scanpy...');
            const url = `${BASE_URL}/scanpy_export?uuid=${uuid}`;
            const options = {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ uuid: uuid })
            };

            fetch(url, options)
                .then(response => {
                    if (!response.ok) throw new Error('Failed to export file');
                    return response.blob();
                })
                .then(blob => {
                    const downloadUrl = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = downloadUrl;
                    a.download = `${uuid}.h5ad`;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    window.URL.revokeObjectURL(downloadUrl);
                    hideLoadingOverlay();
                })
                .catch(error => {
                    console.error("Error during file export:", error);
                    hideLoadingOverlay();

                });
        }

        function toggleParameters() {
            const parametersForm = document.getElementById("parametersForm");
            const downloadTemplateBtn = document.getElementById("downloadTemplateBtn");
        
            if (parametersForm.style.display === "none") {
                parametersForm.style.display = "block";
                downloadTemplateBtn.style.display = "block"; // Show the download button
            } else {
                parametersForm.style.display = "none";
                downloadTemplateBtn.style.display = "none"; // Hide the download button
            }
        }
        
        function downloadConfigTemplate() {
            const templateContent = `
        min_genes=200
        min_cells=3
        mt_threshold=5
        doublet_detection=true
        n_high_variable_genes=2000
        hvg_method=seurat
        n_pcs=15
        n_neighbors=10
        leiden_resolution=1.0
        number_of_genes=4
        statistical_method=wilcoxon
            `.trim(); // Template configuration content
        
            const blob = new Blob([templateContent], { type: "text/plain" });
            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.download = "config_template.txt";
            link.style.display = "none";
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // Handle configuration file upload
        function handleConfigUpload() {
            const fileInput = document.getElementById("configUpload");
            if (fileInput.files.length === 0) {
                alert("Please select a configuration file.");
                return;
            }

            const file = fileInput.files[0];
            const reader = new FileReader();

            reader.onload = function (event) {
                try {
                    const lines = event.target.result.split("\n");
                    configData = {};
                    lines.forEach(line => {
                        const [key, value] = line.split("=");
                        if (key && value) {
                            configData[key.trim()] = value.trim();
                        }
                    });

                    // Populate the form with the config data
                    populateFormWithConfig(configData);

                    document.getElementById("configStatus").innerText = "Configuration loaded successfully!";
                    document.getElementById("configStatus").style.color = "green";
                    document.getElementById("configStatus").style.display = "block";
                } catch (err) {
                    alert("Error parsing configuration file.");
                    document.getElementById("configStatus").innerText = "Failed to load configuration.";
                    document.getElementById("configStatus").style.color = "red";
                    document.getElementById("configStatus").style.display = "block";
                }
            };

            reader.readAsText(file);
        }

        // Function to populate the form fields with configuration data
        function populateFormWithConfig(configData) {
            const parameterKeys = [
                "min_genes",
                "min_cells",
                "mt_threshold",
                "doublet_detection",
                "n_high_variable_genes",
                "hvg_method",
                "n_pcs",
                "n_neighbors",
                "leiden_resolution",
                "number_of_genes",
                "statistical_method"
            ];

            parameterKeys.forEach(key => {
                const field = document.getElementById(key);
                if (field) {
                    if (field.tagName === "SELECT") {
                        // For select dropdowns, match the value
                        const options = Array.from(field.options);
                        const matchingOption = options.find(option => option.value === configData[key]);
                        if (matchingOption) {
                            field.value = configData[key];
                        }
                    } else if (field.tagName === "INPUT") {
                        // For input fields, set the value
                        field.value = configData[key];
                    }
                }
            });
        }
        function saveReproduceParameters() {
            const parameterKeys = [
                "min_genes",
                "min_cells",
                "mt_threshold",
                "doublet_detection",
                "n_high_variable_genes",
                "hvg_method",
                "n_pcs",
                "n_neighbors",
                "leiden_resolution",
                "number_of_genes",
                "statistical_method",
            ];
        
            parameterKeys.forEach((key) => {
                const element = document.getElementById(key);
                if (element) {
                    sessionStorage.setItem(key, element.value || "Unknown");
                }
            });
        }
        
        
        // Get parameter value from config file or input field
        function getParameter(key, defaultValue) {
            let value = sessionStorage.getItem(key);
            if (!value) {
                sessionStorage.setItem(key, defaultValue); // Set default if not already present
                return defaultValue;
            }
            return value;
        }
        
        // Upload file and start the pipeline
        function uploadWithParameters() {
            sessionStorage.clear();
            saveReproduceParameters(); // Save the parameters before running the pipeline

            const analysisName = document.getElementById("analysisName").value;
            const species = document.getElementById("species").value;
            const email = document.getElementById("email").value;
            const geneId = document.getElementById("geneId").value;
            const allowedAnalysisNamesWithoutFile = [
                "example_human",
                "example_mouse",
                "example_zebrafish",
            ];
        
            let proceedWithNoFile = allowedAnalysisNamesWithoutFile.includes(analysisName) && selectedFiles.length === 0;
        
            if (!analysisName || !species || (selectedFiles.length === 0 && !proceedWithNoFile)) {
                let missingFields = [];
                if (!analysisName) missingFields.push("Analysis Name");
                if (!species) missingFields.push("Species");
                if (selectedFiles.length === 0 && !proceedWithNoFile) missingFields.push("File");
        
                alert(`Please fill in the required fields: ${missingFields.join(", ")}`);
                missingFields.forEach((field) => {
                    document.querySelector(`label[for="${field.toLowerCase()}"]`).style.color = "red";
                });
                return;
            }
        
            document.getElementById('loadingOverlay').style.display = 'block';
        
            const formData = new FormData();
            if (!proceedWithNoFile) {
                for (let i = 0; i < selectedFiles.length; i++) {
                    formData.append("files", selectedFiles[i]);
                }
            }
        
            formData.append("species", species);
            formData.append("analysisName", analysisName);
        
            if (email && email.trim() !== "") {
                formData.append("email", email);
            }
            formData.append("flavor", geneId);
        
            // Add custom parameters from the "Reproduce Results" box
            [
                "min_genes",
                "min_cells",
                "mt_threshold",
                "doublet_detection",
                "n_high_variable_genes",
                "hvg_method",
                "n_pcs",
                "n_neighbors",
                "leiden_resolution",
                "number_of_genes",
                "statistical_method",
            ].forEach((param) => {
                const value = document.getElementById(param)?.value || "";
                formData.append(param, value);
            });
        
            let uploadUrl = `${BASE_URL}/upload/`;
            fetch(uploadUrl, {
                method: "POST",
                body: formData,
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(response.statusText);
                    }
                    return response.json();
                })
                .then(data => {
                    sessionStorage.setItem("uuid", data.uuid);
                    sessionStorage.setItem("analysisName", analysisName);
                    sessionStorage.setItem("datasetDescription", JSON.stringify(data.dataset_description));
                    sessionStorage.setItem("plots_path", JSON.stringify(data.plots_path));
        
                    const datasetDescription = data.dataset_description;
        
                    const summaryParagraph = document.querySelector(".dataset-summary");
                    summaryParagraph.innerText = `The dataset contains ${datasetDescription.num_observations} cells and ${datasetDescription.num_variables} genes. It has an average of ${(Number(datasetDescription.mean_n_genes_by_counts)).toFixed(2)} genes per cell with a standard deviation of ${(Number(datasetDescription.std_n_genes_by_counts)).toFixed(2)}. The average total counts per cell is ${(Number(datasetDescription.mean_total_counts)).toFixed(2)} with a standard deviation of ${(Number(datasetDescription.std_total_counts)).toFixed(2)}. Lastly, the average of mitochondrial genes is ${(Number(datasetDescription.mean_pct_counts_mito)).toFixed(2)} with a standard deviation of ${(Number(datasetDescription.std_pct_counts_mito)).toFixed(2)}. The AnnData file contains ${datasetDescription.cell_observations} cell-level and ${datasetDescription.gene_observations} gene-level observations.`;
        
                    document.getElementById('loadingOverlay').style.display = 'none';
        
                    document.querySelector(".results-container").style.display = "block";
                    clearPlots();
                    if (data.plots_path && data.plots_path.length > 0) {
                        data.plots_path.forEach((plotUrl, index) => {
                            displayPlot(plotUrl, index + 1);
                        });
                    }
                    // Buttons are now inside the results container
        
                    // Automatically start pipeline if data is ready
                    runPipeline();
                })
                .catch(error => {
                    alert("Error uploading file: " + error.message);
                    document.getElementById('loadingOverlay').style.display = 'none';
                });
        }
        
        
        // Run pipeline sequentially
        function runPipeline(uuid = null) {
            // Get the UUID from sessionStorage if not passed as an argument
            if (!uuid) {
                uuid = sessionStorage.getItem("uuid");
            }
        
            if (!uuid) {
                alert("UUID not found. Please upload a file or select an example.");
                return;
            }
            saveReproduceParameters(); // Save parameters to sessionStorage before running

            const loadingText = document.querySelector("#loadingOverlay p"); // Select the loading text element
            const loadingOverlay = document.getElementById("loadingOverlay");
        
            // Show overlay and update text for the first step
            loadingOverlay.style.display = "block";
            loadingText.textContent = "Preprocessing...";
        
            // Chain promises for the pipeline
            startPreprocessing(uuid)
                .then(() => {
                    loadingText.textContent = "Embedding...";
                    setPipelineParameters();

                    return startEmbedding(uuid);
                })
                .then(() => {
                    loadingText.textContent = "Differential Expression Analysis...";
                    return startDEA(uuid);
                })
                .then(() => {
                    loadingText.textContent = "Creating Report...";
                    return generatePDFReport(uuid); // Wait for PDF generation and upload to complete
                })
                .then(() => {
                    console.log("Pipeline completed successfully.");
                    loadingOverlay.style.display = "none";
                    window.location.href = "/scexplorer/results"; // Redirect after all steps are done
                })
                .catch(error => {
                    console.error("Pipeline error:", error);
                    loadingOverlay.style.display = "none";
                    alert("Error during pipeline execution. Please check the logs.");
                });
        }
        function setPipelineParameters() {
            // Collect parameter values from the form
            const parameters = {
                min_genes: document.getElementById("min_genes")?.value,
                min_cells: document.getElementById("min_cells")?.value,
                mt_threshold: document.getElementById("mt_threshold")?.value,
                n_high_variable_genes: document.getElementById("n_high_variable_genes")?.value,
                hvg_method: document.getElementById("hvg_method")?.value,
                n_neighbors: document.getElementById("n_neighbors")?.value,
                n_pcs: document.getElementById("n_pcs")?.value,
                leiden_resolution: document.getElementById("leiden_resolution")?.value,
                doublet_detection: document.getElementById("doublet_detection")?.value,
                number_of_genes: document.getElementById("number_of_genes")?.value,
                statistical_method: document.getElementById("statistical_method")?.value,


            };
        
            // Check for missing parameters
            const missingFields = Object.keys(parameters).filter((key) => !parameters[key]);
        
            if (missingFields.length > 0) {
                alert(`Please fill in the required fields: ${missingFields.join(", ")}`);
                throw new Error(`Missing required parameters: ${missingFields.join(", ")}`);
            }
        
            // Save parameters to sessionStorage
            Object.keys(parameters).forEach((key) => {
                sessionStorage.setItem(key, parameters[key]);
            });
        
            console.log("Pipeline parameters set:", parameters); // Debugging log
        }
        
        // Start preprocessing step
        function startPreprocessing(uuid) {
            const min_genes = getParameter("min_genes", "Unknown");
            const min_cells = getParameter("min_cells", "Unknown");
            const mt_threshold = getParameter("mt_threshold", "Unknown");
            const doublet_detection = getParameter("doublet_detection", "true");
    
            return fetch(`${BASE_URL}/process/${uuid}/?min_genes=${min_genes}&min_cells=${min_cells}&mito_threshold=${mt_threshold}&doublet_detection=${doublet_detection}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error("Preprocessing failed.");
                    }
                    return response.json();
                })
                .then(data => {
                    savePreprocessingStats(data); // Save stats here
                    if (data.processing_plot_paths) {
                        sessionStorage.setItem("preprocess_path", JSON.stringify(data.processing_plot_paths));
                    } else {
                        console.warn("No preprocessing plots returned by the server.");
                    }
                    return data;                 });
        }
        
        // Start embedding step
        function startEmbedding(uuid) {
            const n_genesValue = getParameter("n_high_variable_genes", "Unknown");
            const flavor_hvg = getParameter("hvg_method", "Unknown");
            const n_neighborsValue = getParameter("n_neighbors", "Unknown");
            const n_pcsValue = getParameter("n_pcs", "Unknown");
            const resolutionValue = getParameter("leiden_resolution", "Unknown");
    
            let pcaUrl = `${BASE_URL}/pca?file_uuid=${uuid}`;
    
            return fetch(pcaUrl, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    n_genes: parseInt(n_genesValue),
                    flavor: flavor_hvg
                })
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error("PCA calculation failed.");
                    }
                    return response.json();
                })
                .then(pcaData => {
                    return fetch(`${BASE_URL}/embedding/?file_uuid=${uuid}&n_neighbors=${n_neighborsValue}&n_pcs=${n_pcsValue}&resolution=${resolutionValue}`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                    });
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error("Embedding failed.");
                    }
                    return response.json();
                })
                .then(embeddingData => {
                    saveEmbeddingStats(embeddingData); // Save stats here
                });
        }
    
        function startDEA(uuid) {
            const number_of_genes = getParameter("number_of_genes", 4);
            const statistical_method = getParameter("statistical_method", "wilcoxon");
    
            return fetch(`${BASE_URL}/DEA/?file_uuid=${uuid}&n_genes=${number_of_genes}&flavor=mean_expression&method=${statistical_method}`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error("DEA failed.");
                    }
                    return response.json();
                })
                .then(data => {

                    if (Array.isArray(data)) {
                        sessionStorage.setItem("dea_plot_paths", JSON.stringify(data));
                    } else {
                        console.warn("No DEA plots returned by the server.");
                    }
                    return data;// Save stats here
                });
        }


        // Function to generate the PDF report
        function generatePDFReport(uuid) {
            return new Promise((resolve, reject) => {
                // Ensure jsPDF is loaded
                const { jsPDF } = window.jspdf;
                if (!jsPDF) {
                    console.error("jsPDF library is not loaded.");
                    reject("jsPDF library is not loaded.");
                    return;
                }
                // Base64 string of the logo (replace this with your actual Base64 logo string)
                const logoBase64 = "data:image/png;base64,";
                // Retrieve session data
                const preprocessingParams = {
                    min_genes: sessionStorage.getItem("min_genes"),
                    min_cells: sessionStorage.getItem("min_cells"),
                    mito_threshold: sessionStorage.getItem("mt_threshold"),
                    doublet_detection: sessionStorage.getItem("doublet_detection"),
                };
        
                const preprocessingStats = {
                    cells_before: sessionStorage.getItem("cells_before"),
                    cells_after: sessionStorage.getItem("cells_after"),
                    genes_before: sessionStorage.getItem("genes_before"),
                    genes_after: sessionStorage.getItem("genes_after"),
                };
        
                const embeddingParams = {
                    n_high_variable_genes: sessionStorage.getItem("n_high_variable_genes"),
                    hvg_method: sessionStorage.getItem("hvg_method"),
                    n_neighbors: sessionStorage.getItem("n_neighbors"),
                    n_pcs: sessionStorage.getItem("n_pcs"),
                    leiden_resolution: sessionStorage.getItem("leiden_resolution"),
                };
        
                const deaParams = {
                    number_of_genes: sessionStorage.getItem("number_of_genes"),
                    statistical_method: sessionStorage.getItem("statistical_method"),
                };
        
                const versions = `
                    scExplorer: v1.1.0
                    Scanpy: v1.9.2
                    Seurat: v5.1.0
                    Scrublet: v0.2.3
                    Clustree: v0.5.1
                `;
        
                // Initialize jsPDF
                const doc = new jsPDF();

                doc.addImage(logoBase64, "PNG", 10, 2, 30, 30, null, "FAST"); 
                // Add Title
                doc.setFontSize(16);
                doc.setFont("Helvetica", "bold");
                doc.text("scRNA-seq Analysis Report", 105, 20, null, null, "center");
        
                // Add Introduction
                doc.setFontSize(12);
                doc.setFont("Helvetica", "normal");
                doc.text(
                    "This report summarizes the scRNA-seq analysis conducted using scExplorer. The analysis includes preprocessing, dimensionality reduction, clustering, and differential expression analysis. The results and methods are detailed below, providing insights into cellular diversity and gene expression patterns.",
                    10,
                    35,
                    { maxWidth: 190 }
                );
        
                // Add Preprocessing Section
                doc.setFont("Helvetica", "bold");
                doc.text("Preprocessing", 10, 60);
                doc.setFont("Helvetica", "normal");
                doc.text(
                    `Quality control measures included filtering out cells expressing fewer than ${preprocessingParams.min_genes} genes and genes detected in fewer than ${preprocessingParams.min_cells} cells. Cells exhibiting over ${preprocessingParams.mito_threshold}% mitochondrial gene expression were excluded to remove potential apoptotic cells. Doublet detection was performed using Scrublet v0.2.3, and identified doublets were ${preprocessingParams.doublet_detection === "true" ? "removed" : "not removed"} from the dataset. Before preprocessing, the dataset contained ${preprocessingStats.cells_before} cells and ${preprocessingStats.genes_before} genes. After filtering, ${preprocessingStats.cells_after} cells and ${preprocessingStats.genes_after} genes remained, ensuring a high-quality dataset for analysis.`,
                    10,
                    70,
                    { maxWidth: 190 }
                );
        
                // Add Normalization and HVG Section
                doc.setFont("Helvetica", "bold");
                doc.text("Normalization and Identification of Highly Variable Genes", 10, 105);
                doc.setFont("Helvetica", "normal");
                doc.text(
                    `Data normalization was performed using the LogNormalize method, scaling gene expression to 10,000 transcripts per cell. Highly variable genes were identified using the ${embeddingParams.hvg_method} method, selecting the top ${embeddingParams.n_high_variable_genes} variable genes for downstream analysis.`,
                    10,
                    115,
                    { maxWidth: 190 }
                );
        
                // Add Embedding Section
                doc.setFont("Helvetica", "bold");
                doc.text("Dimensionality Reduction and Clustering", 10, 135);
                doc.setFont("Helvetica", "normal");
                doc.text(
                    `Principal Component Analysis (PCA) was conducted on the scaled data, retaining the top ${embeddingParams.n_pcs} principal components. A nearest-neighbor graph was constructed using the ${embeddingParams.n_neighbors} nearest neighbors. Clustering was performed using the Leiden algorithm with a resolution parameter of ${embeddingParams.leiden_resolution}. Dimensionality reduction for visualization was achieved using Uniform Manifold Approximation and Projection (UMAP).`,
                    10,
                    145,
                    { maxWidth: 190 }
                );
        
                // Add DEA Section
                doc.setFont("Helvetica", "bold");
                doc.text("Differential Expression Analysis", 10, 175);
                doc.setFont("Helvetica", "normal");
                doc.text(
                    `Differential expression analysis was conducted to identify marker genes for each cluster. The ${deaParams.statistical_method} test was employed to determine statistical significance, with a threshold of adjusted p-value < 0.05. The top ${deaParams.number_of_genes} differentially expressed genes per cluster were reported.`,
                    10,
                    185,
                    { maxWidth: 190 }
                );
        
                // Add Versions Section
                doc.setFont("Helvetica", "bold");
                doc.text("Software Versions", 10, 205);
                doc.setFont("Helvetica", "normal");
                doc.text(versions, 10, 210, { maxWidth: 190 });
        
                // Convert the PDF to a Blob
                const pdfBlob = doc.output("blob");
        
                // Prepare the FormData to send to the backend
                const formData = new FormData();
                formData.append("file", pdfBlob, "analysis_report.pdf");
                formData.append("uuid", uuid);
        
                // Send the Blob to the backend
                fetch(`${BASE_URL}/pdf_report/`, {
                    method: "POST",
                    body: formData,
                })
                    .then((response) => {
                        if (!response.ok) {
                            throw new Error("Failed to upload the PDF");
                        }
                        return response.json();
                    })
                    .then((data) => {
                        console.log("PDF uploaded successfully:", data);
                        resolve(data); // Resolve the promise on success
                    })
                    .catch((error) => {
                        console.error("Error uploading PDF:", error);
                        reject(error); // Reject the promise on error
                    });
            });
        }
        
        
        </script>
        
        <!-- Theme Manager Script -->
        <script src="/scexplorer/js/theme-manager-new.js"></script>
