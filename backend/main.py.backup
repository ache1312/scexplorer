# ENHANCED VISUALIZATION ENDPOINTS WITH THEME SUPPORT
# ============================================================================

@app.post("/genes_visualization_themed/", tags=["🎨 Step 5: Visualization"], summary="Gene Visualization with Theme Support")
async def themed_genes_visualization(vis: VisualizationWithTheme):
    """
    **Create gene expression visualizations with custom theme support.**
    
    This enhanced version of gene visualization allows users to apply
    custom themes for personalized color palettes, fonts, and layouts.
    
    **Request Body (VisualizationWithTheme):**
    - Includes all standard visualization parameters
    - Optional theme_name for predefined themes
    - Optional custom_theme for on-the-fly customization
    
    **Theme Integration:**
    - Uses specified theme for color mapping
    - Applies custom fonts and layouts
    - Supports accessibility options
    - Maintains consistency across plots
    
    **Returns:**
    Same format as standard gene visualization but with themed plots.
    """
    try:
        # Set theme if specified
        if vis.theme_name and vis.theme_name != "default":
            if vis.theme_name not in theme_manager.list_themes():
                raise HTTPException(status_code=400, detail=f"Theme '{vis.theme_name}' not found")
            theme_manager.set_current_theme(vis.theme_name)
        
        # Handle custom theme
        if vis.custom_theme:
            custom_theme = PlotTheme(f"temp_{vis.file_uuid}")
            if vis.custom_theme.colors:
                custom_theme.colors.update(vis.custom_theme.colors.dict())
            if vis.custom_theme.fonts:
                custom_theme.fonts.update(vis.custom_theme.fonts.dict())
            # Add other custom theme properties...
            
            theme_manager.add_custom_theme(custom_theme)
            theme_manager.set_current_theme(custom_theme.theme_name)
        
        # Use existing visualization logic with theme support
        from utils import genes_visualization_themed
        
        dir_path = os.path.join(UPLOAD_FOLDER, vis.file_uuid)
        file_path = os.path.join(dir_path, f"{vis.file_uuid}.h5ad")
        
        if not os.path.exists(file_path):
            raise HTTPException(status_code=404, detail="Analysis file not found")
        
        genes_plots_directory = os.path.join(dir_path, "visualization")
        os.makedirs(genes_plots_directory, exist_ok=True)
        
        # Generate themed plots
        plot_paths = genes_visualization_themed(
            file_path, 
            genes_plots_directory, 
            vis.dim_red, 
            vis.gene_list,
            theme_name=vis.theme_name or "default"
        )
        
        return {
            "gene_expression_plots": plot_paths,
            "theme_applied": vis.theme_name or "default",
            "genes_visualized": len(vis.gene_list)
        }
    
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to generate themed visualization: {str(e)}")


