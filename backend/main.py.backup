# Middleware que recorta el prefijo /backend y fija root_path
class PrefixStripMiddleware(BaseHTTPMiddleware):
    def __init__(self, app, prefix: str = "/backend"):
        super().__init__(app)
        self.prefix = prefix

    async def dispatch(self, request: Request, call_next):
        path = request.scope.get("path", "")
        if path == self.prefix:
            # exacto /backend -> convertir a "/"
            request.scope["root_path"] = self.prefix
            request.scope["path"] = "/"
        elif path.startswith(self.prefix + "/"):
            # /lo-que-sea -> quitar prefijo
            request.scope["root_path"] = self.prefix
            request.scope["path"] = path[len(self.prefix):] or "/"
        return await call_next(request)


