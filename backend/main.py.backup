@app.post("/themes/", tags=["🎨 Theme Management"], summary="Create Custom Theme")
async def create_custom_theme(theme_request: PlotThemeRequest):
    """
    **Create a new custom theme with personalized settings.**
    
    Allows users to define their own color palettes, fonts, layouts,
    and accessibility options for a completely customized visualization experience.
    
    **Request Body (PlotThemeRequest):**
    Complete theme specification with validation for all parameters.
    
    **Returns:**
    ```json
    {
        "message": "Theme created successfully",
        "theme_name": "my_custom_theme",
        "preview": {...}
    }
    ```
    
    **HTTP Status Codes:**
    - `201`: Theme created successfully
    - `400`: Invalid theme configuration
    - `409`: Theme name already exists
    - `422`: Validation errors in theme parameters
    """
    try:
        # Check if theme already exists
        if theme_request.theme_name in theme_manager.list_themes():
            raise HTTPException(status_code=409, detail=f"Theme '{theme_request.theme_name}' already exists")
        
        # Create theme from request
        theme = PlotTheme(theme_request.theme_name)
        
        # Update theme with custom settings
        if theme_request.colors:
            theme.colors.update(theme_request.colors.dict())
            # Update plot-specific configurations with colors from the request
            if hasattr(theme_request.colors, 'primary_palette'):
                for plot_type in theme.plot_types:
                    if 'colors' in theme.plot_types[plot_type]:
                        theme.plot_types[plot_type]['colors'] = theme_request.colors.primary_palette
        if theme_request.fonts:
            theme.fonts.update(theme_request.fonts.dict())
        if theme_request.layout:
            theme.layout.update(theme_request.layout.dict())
        if theme_request.markers:
            theme.markers.update(theme_request.markers.dict())
            # Update violin plot-specific settings with markers opacity and line_width
            if hasattr(theme_request.markers, 'opacity'):
                theme.plot_types['violin_plots']['opacity'] = theme_request.markers.opacity
            if hasattr(theme_request.markers, 'line_width'):
                theme.plot_types['violin_plots']['line_width'] = theme_request.markers.line_width
        if theme_request.accessibility:
            theme.accessibility.update(theme_request.accessibility.dict())
            theme.apply_accessibility_options()
        
        # Add to theme manager
        theme_manager.add_custom_theme(theme)
        
        return {
            "message": "Theme created successfully",
            "theme_name": theme.theme_name,
            "preview": create_theme_preview(theme)
        }
    
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to create theme: {str(e)}")


@app.put("/themes/current/{theme_name}/", tags=["🎨 Theme Management"], summary="Set Current Theme")
async def set_current_theme(theme_name: str):
    """
    **Set the active theme for all subsequent plot generation.**
    
    Changes the global theme setting that will be used for all new plots
    until changed again. Affects all visualization endpoints.
    
    **Parameters:**
    - **theme_name**: str - Name of theme to activate
    
    **Returns:**
    ```json
    {
        "message": "Theme set successfully",
        "current_theme": "dark",
        "previous_theme": "default"
    }
    ```
    
    **HTTP Status Codes:**
    - `200`: Theme changed successfully
    - `404`: Theme not found
    - `500`: Server error
    
    **Note:** This affects all users globally. For production deployment,
    consider implementing user-specific theme preferences.
    """
    try:
        if theme_name not in theme_manager.list_themes():
            raise HTTPException(status_code=404, detail=f"Theme '{theme_name}' not found")
        
        previous_theme = theme_manager.current_theme
        theme_manager.set_current_theme(theme_name)
        
        return {
            "message": "Theme set successfully",
            "current_theme": theme_name,
            "previous_theme": previous_theme
        }
    
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to set theme: {str(e)}")


@app.delete("/themes/{theme_name}/", tags=["🎨 Theme Management"], summary="Delete Custom Theme")
async def delete_theme(theme_name: str):
    """
    Remove a custom theme from the server. Predefined themes cannot be removed.
    
    Returns current theme after deletion (may fallback to 'default' if removed theme was active).
    """
    try:
        # Validate exists
        if theme_name not in theme_manager.list_themes():
            raise HTTPException(status_code=404, detail=f"Theme '{theme_name}' not found")
        
        # Attempt removal (raises ValueError if protected)
        theme_manager.remove_theme(theme_name)
        
        return {
            "message": f"Theme '{theme_name}' deleted",
            "current_theme": theme_manager.current_theme,
            "themes": theme_manager.list_themes()
        }
    except ValueError as ve:
        raise HTTPException(status_code=400, detail=str(ve))
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to delete theme: {str(e)}")


@app.put("/themes/accessibility/", tags=["🎨 Theme Management"], summary="Update Theme Accessibility Settings")
async def update_accessibility_settings(accessibility_settings: dict):
    """
    **Update accessibility settings for the current theme.**
    
    Applies accessibility options like high contrast, colorblind-friendly palettes,
    and large text to the currently active theme.
    
    **Request Body:**
    ```json
    {
        "high_contrast": true,
        "colorblind_friendly": false,
        "large_text": true,
        "simplified_layout": false
    }
    ```
    
    **Returns:**
    ```json
    {
        "message": "Accessibility settings updated",
        "current_theme": "default",
        "accessibility": {
            "high_contrast": true,
            "colorblind_friendly": false,
            "large_text": true,
            "simplified_layout": false
        }
    }
    ```
    """
    try:
        current_theme = theme_manager.get_theme()
        
        # Debug: Print before changes
        print(f"BEFORE - Theme: {current_theme.theme_name}")
        print(f"BEFORE - Primary palette: {current_theme.colors['primary_palette']}")
        print(f"BEFORE - Continuous palette: {current_theme.colors['continuous_palette']}")
        print(f"BEFORE - Accessibility: {current_theme.accessibility}")
        
        # Update accessibility settings
        for key, value in accessibility_settings.items():
            if key in current_theme.accessibility:
                current_theme.accessibility[key] = value
        
        # Apply the accessibility options
        current_theme.apply_accessibility_options()
        
        # Debug: Print after changes
        print(f"AFTER - Primary palette: {current_theme.colors['primary_palette']}")
        print(f"AFTER - Continuous palette: {current_theme.colors['continuous_palette']}")
        print(f"AFTER - Accessibility: {current_theme.accessibility}")
        
        return {
            "message": "Accessibility settings updated",
            "current_theme": current_theme.theme_name,
            "accessibility": current_theme.accessibility
        }
    
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to update accessibility settings: {str(e)}")


def modify_plotly_html_colors_new(html_file_path: str, new_colors: list, file_uuid: str) -> bool:
    """
    Modify colors in Plotly HTML files using JavaScript injection for continuous scales
    and direct replacement for discrete sequences.
    """
    try:
        with open(html_file_path, 'r', encoding='utf-8') as f:
            html_content = f.read()
        
        import re
        modified = False
        
        # Check if this is a continuous color scale plot (first parameter is a palette name)
        is_continuous_plot = len(new_colors) > 0 and isinstance(new_colors[0], str) and new_colors[0].lower() in [
            'viridis', 'plasma', 'inferno', 'magma', 'cividis', 'turbo', 'rainbow', 'greys', 'rdbu'
        ]
        
        # Check if this is a discrete color injection (first parameter is "DISCRETE_PALETTE")
        is_discrete_injection = len(new_colors) > 0 and new_colors[0] == "DISCRETE_PALETTE"
        
        if is_continuous_plot:
            # Handle continuous color scale plots (PCA/UMAP) with JavaScript injection
            new_palette = new_colors[0].capitalize()  # e.g., "Turbo"
            
            # Create JavaScript snippet to force the new colorscale
            inject_snippet = f'''
<script>
(function() {{
  function setColorscale(gd) {{
    var n = (gd._fullData || []).length;
    for (var i = 0; i < n; i++) {{
      try {{ Plotly.restyle(gd, {{'marker.colorscale': '{new_palette}'}}, [i]); }} catch(e){{}}
      try {{ Plotly.restyle(gd, {{'colorscale': '{new_palette}'}}, [i]); }} catch(e){{}}
      try {{ Plotly.restyle(gd, {{'line.colorscale': '{new_palette}'}}, [i]); }} catch(e){{}}
      try {{ Plotly.restyle(gd, {{'z': gd._fullData[i].z, 'colorscale': '{new_palette}'}}, [i]); }} catch(e){{}}
    }}
    if (gd._fullLayout) {{
      Object.keys(gd._fullLayout).forEach(function(k){{
        if (k.indexOf('coloraxis') === 0) {{
          var u = {{}}; u[k + '.colorscale'] = '{new_palette}';
          try {{ Plotly.relayout(gd, u); }} catch(e){{}}
        }}
      }});
    }}
  }}
  function applyAll() {{
    var graphs = document.querySelectorAll('.plotly-graph-div');
    for (var j = 0; j < graphs.length; j++) setColorscale(graphs[j]);
  }}
  if (document.readyState === 'loading') {{
    document.addEventListener('DOMContentLoaded', function(){{ setTimeout(applyAll, 100); }});
  }} else {{
    setTimeout(applyAll, 100);
  }}
}})();
</script>
'''
            
            # Inject before closing </body> tag
            lower_html = html_content.lower()
            body_end_idx = lower_html.rfind("</body>")
            
            if body_end_idx != -1:
                html_content = html_content[:body_end_idx] + inject_snippet + html_content[body_end_idx:]
                modified = True
                print(f"Injected JavaScript to force colorscale: {new_palette}")
            else:
                # If no </body> tag, append at the end
                html_content += inject_snippet
                modified = True
                print(f"Appended JavaScript to force colorscale: {new_palette}")
        
        elif is_discrete_injection:
            # Handle discrete color palette injection using the robust JavaScript method
            discrete_colors = new_colors[1:]  # Skip the "DISCRETE_PALETTE" signal
            
            # Create JavaScript snippet for discrete palette injection
            discrete_inject_snippet = f'''
<script>
(function() {{
  var PALETTE = {discrete_colors};
  function arrayify(x){{ return Array.isArray(x) ? x : [x]; }}
  function colorizeTrace(gd, traceIndex, color) {{
    try {{ Plotly.restyle(gd, {{'marker.color': color}}, [traceIndex]); }} catch(e){{}}
    try {{ Plotly.restyle(gd, {{'line.color': color}},   [traceIndex]); }} catch(e){{}}
  }}
  function recolor(gd) {{
    var full = (gd && gd._fullData) || [];
    var byKey = Object.create(null);
    var next = 0;
    for (var i = 0; i < full.length; i++) {{
      var t = full[i] || {{}};
      var hasScale = (t.marker && (t.marker.colorscale || t.marker.colorbar || t.marker.cmin !== undefined || t.marker.cmax !== undefined));
      if (hasScale) continue;
      var key = t.legendgroup || t.name || ("trace-"+i);
      if (!(key in byKey)) {{
        byKey[key] = PALETTE[next % PALETTE.length];
        next++;
      }}
      if (t.marker && Array.isArray(t.marker.color)) {{
        var arr = t.marker.color;
        var map = Object.create(null);
        var uniques = [];
        for (var j=0; j<arr.length; j++) {{
          var v = String(arr[j]);
          if (!(v in map)) {{ map[v] = PALETTE[uniques.length % PALETTE.length]; uniques.push(v); }}
        }}
        var newArr = arr.map(function(v){{ return map[String(v)]; }});
        try {{ Plotly.restyle(gd, {{'marker.color': [newArr]}}, [i]); }} catch(e){{}}
      }} else {{
        colorizeTrace(gd, i, byKey[key]);
      }}
    }}
    try {{ Plotly.relayout(gd, {{'colorway': PALETTE}}); }} catch(e){{}}
  }}
  function run() {{
    var graphs = document.querySelectorAll('.plotly-graph-div');
    graphs.forEach(function(gd){{ recolor(gd); }});
  }}
  if (document.readyState === 'loading') {{
    document.addEventListener('DOMContentLoaded', function(){{ setTimeout(run, 0); }});
  }} else {{
    setTimeout(run, 0);
  }}
}})();
</script>
'''
            
            # Inject before closing </body> tag
            lower_html = html_content.lower()
            body_end_idx = lower_html.rfind("</body>")
            
            if body_end_idx != -1:
                html_content = html_content[:body_end_idx] + discrete_inject_snippet + html_content[body_end_idx:]
                modified = True
                print(f"Injected JavaScript for discrete palette: {len(discrete_colors)} colors")
            else:
                # If no </body> tag, append at the end
                html_content += discrete_inject_snippet
                modified = True
                print(f"Appended JavaScript for discrete palette: {len(discrete_colors)} colors")
        
        else:
            # Handle discrete color plots (violin, scatter, discrete UMAP) with direct replacement
            color_sequence_pattern = r'"color_discrete_sequence":\s*\[(.*?)\]'
            match = re.search(color_sequence_pattern, html_content)
            
            if match:
                new_sequence = ', '.join([f'"{color}"' for color in new_colors])
                new_color_array = f'"color_discrete_sequence": [{new_sequence}]'
                html_content = re.sub(color_sequence_pattern, new_color_array, html_content)
                modified = True
                print(f"Updated color_discrete_sequence with new colors: {new_colors}")
            
            # Also look for discrete color maps (used by UMAP leiden plots) - don't use elif
            if not modified:
                discrete_map_pattern = r'"color_discrete_map":\s*\{([^}]*)\}'
                map_match = re.search(discrete_map_pattern, html_content)
                
                if map_match and len(new_colors) > 0:
                    old_map_content = map_match.group(1)
                    # Extract the keys (cluster names) from the old map
                    key_pattern = r'"([^"]+)":\s*"[^"]*"'
                    keys = re.findall(key_pattern, old_map_content)
                    
                    # Create new color map with same keys but new colors
                    new_map_entries = []
                    for i, key in enumerate(keys):
                        color = new_colors[i % len(new_colors)]
                        new_map_entries.append(f'"{key}": "{color}"')
                    
                    new_map_content = ', '.join(new_map_entries)
                    new_color_map = f'"color_discrete_map": {{{new_map_content}}}'
                    html_content = re.sub(discrete_map_pattern, new_color_map, html_content)
                    modified = True
                    print(f"Updated color_discrete_map with {len(keys)} cluster colors from theme palette")
            
            # Handle elbow plots - independent check (not elif)
            if not modified:
                # Handle elbow plots - they use individual marker colors in arrays
                # Look for marker color arrays like: "color": ["DarkGreen", "DarkGreen", "red", ...]
                marker_color_pattern = r'"color":\s*\[(.*?)\]'
                marker_match = re.search(marker_color_pattern, html_content, re.DOTALL)
                
                if marker_match and len(new_colors) >= 2:
                    base_color, highlight_color = new_colors[0], new_colors[1]
                    old_colors_str = marker_match.group(1)
                    
                    # Create comprehensive theme color mapping for intelligent replacement
                    theme_color_map = {
                        # All possible base colors from all themes
                        "base_colors": [
                            "DarkGreen",    # Default theme
                            "#1abc9c",      # Dark theme
                            "#0173b2",      # Colorblind theme
                            "#ffffff",      # High contrast theme
                            "#333333",      # Publication theme
                            "#4ecdc4"       # Vibrant theme
                        ],
                        # All possible highlight colors from all themes
                        "highlight_colors": [
                            "red",          # Default theme
                            "#e74c3c",      # Dark theme
                            "#de8f05",      # Colorblind theme
                            "#ff0000",      # High contrast theme
                            "#666666",      # Publication theme
                            "#ff6b6b"       # Vibrant theme
                        ]
                    }
                    
                    updated_colors = old_colors_str
                    
                    # Replace ALL possible base colors with the new base color
                    for old_base_color in theme_color_map["base_colors"]:
                        pattern = f'"{old_base_color}"'
                        if pattern in updated_colors:
                            updated_colors = updated_colors.replace(pattern, f'"{base_color}"')
                            print(f"  Replaced base color {old_base_color} → {base_color}")
                    
                    # Replace ALL possible highlight colors with the new highlight color
                    for old_highlight_color in theme_color_map["highlight_colors"]:
                        pattern = f'"{old_highlight_color}"'
                        if pattern in updated_colors:
                            updated_colors = updated_colors.replace(pattern, f'"{highlight_color}"')
                            print(f"  Replaced highlight color {old_highlight_color} → {highlight_color}")
                    
                    # Check if any changes were made
                    if updated_colors != old_colors_str:
                        new_marker_array = f'"color": [{updated_colors}]'
                        html_content = re.sub(marker_color_pattern, new_marker_array, html_content, flags=re.DOTALL)
                        modified = True
                        print(f"Updated elbow plot marker colors: base='{base_color}', highlight='{highlight_color}'")
                    else:
                        print(f"No matching colors found to replace in elbow plot")
        
        # Write the modified content back to the file
        if modified:
            with open(html_file_path, 'w', encoding='utf-8') as f:
                f.write(html_content)
            print(f"SUCCESS: Applied {'continuous' if is_continuous_plot else 'discrete'} color changes")
            return True
        else:
            print(f"No modifications were made to {html_file_path}")
            return False
            
    except Exception as e:
        print(f"Error modifying HTML file {html_file_path}: {e}")
        return False

def modify_plotly_html_colors(html_file_path: str, new_colors: list, file_uuid: str) -> bool:
    """
    Modify colors in an existing Plotly HTML file by using UUID-based div identification.
    Much simpler and more reliable than regex parsing.
    
    Parameters:
    - html_file_path: Path to the HTML file to modify  
    - new_colors: List of new colors to apply
    - file_uuid: UUID to identify the specific plot div
    
    Returns:
    - bool: True if successful, False otherwise
    """
    try:
        # Read the HTML file
        with open(html_file_path, 'r', encoding='utf-8') as f:
            html_content = f.read()
        
        # Focus on replacing color_discrete_sequence arrays - more reliable than individual color replacement
        import re
        modified = False
        
        # Try to replace any color_discrete_sequence array directly
        color_sequence_pattern = r'"color_discrete_sequence":\s*\[(.*?)\]'
        match = re.search(color_sequence_pattern, html_content)
        
        if match:
            # Build new color sequence
            new_sequence = ', '.join([f'"{color}"' for color in new_colors])
            new_color_array = f'"color_discrete_sequence": [{new_sequence}]'
            html_content = re.sub(color_sequence_pattern, new_color_array, html_content)
            modified = True
            print(f"Updated color_discrete_sequence with new colors: {new_colors}")
        
        # For continuous color scales (PCA/UMAP plots), handle differently
        # Replace actual viridis patterns found in Plotly HTML files
        continuous_palette_applied = False
        if not modified and len(new_colors) > 0 and isinstance(new_colors[0], str):
            new_palette = new_colors[0].lower()  # e.g., "turbo"
            new_palette_cap = new_colors[0].capitalize()  # e.g., "Turbo"
            
            # Replace the different viridis patterns with the new palette
            replacements_made = 0
            
            # Pattern 1: colorscaleDflt:"Viridis" -> colorscaleDflt:"Turbo"
            if 'colorscaleDflt:"Viridis"' in html_content:
                html_content = html_content.replace('colorscaleDflt:"Viridis"', f'colorscaleDflt:"{new_palette_cap}"')
                replacements_made += 1
                print(f"Replaced colorscaleDflt: Viridis -> {new_palette_cap}")
            
            # Pattern 2: colorscaleDflt:"viridis" -> colorscaleDflt:"turbo" (lowercase)  
            if 'colorscaleDflt:"viridis"' in html_content:
                html_content = html_content.replace('colorscaleDflt:"viridis"', f'colorscaleDflt:"{new_palette}"')
                replacements_made += 1
                print(f"Replaced colorscaleDflt: viridis -> {new_palette}")
            
            # Pattern 3: Replace any standalone "viridis" with new palette in colorscale contexts
            # Use word boundaries to avoid replacing parts of other words
            viridis_pattern = r'\bviridis\b'
            viridis_matches = len(re.findall(viridis_pattern, html_content, re.IGNORECASE))
            if viridis_matches > 0:
                html_content = re.sub(r'\bViridis\b', new_palette_cap, html_content)
                html_content = re.sub(r'\bviridis\b', new_palette, html_content) 
                replacements_made += viridis_matches
                print(f"Replaced {viridis_matches} instances of viridis/Viridis with {new_palette}/{new_palette_cap}")
            
            if replacements_made > 0:
                continuous_palette_applied = True
                modified = True
                print(f"Successfully applied continuous palette: {new_colors[0]} ({replacements_made} replacements)")
        
        # For plots with continuous palettes, also replace discrete hex colors if they exist
        # This handles mixed plots that have both continuous scales and discrete color elements
        if continuous_palette_applied and len(new_colors) > 1:
            print(f"Also replacing discrete hex colors with theme colors: {new_colors[1:]}")
            hex_color_pattern = r'"(#[0-9a-fA-F]{6})"'
            hex_matches = re.findall(hex_color_pattern, html_content)
            
            if hex_matches:
                print(f"Found hex colors to replace: {hex_matches[:5]}")
                # Use colors starting from index 1 (skip the palette name at index 0)
                discrete_colors_to_use = new_colors[1:]
                
                for i, new_color in enumerate(discrete_colors_to_use):
                    if i < len(hex_matches):
                        old_color = hex_matches[i]
                        search_pattern = f'"{old_color}"'
                        replacement = f'"{new_color}"'
                        
                        count_before = html_content.count(search_pattern)
                        if count_before > 0:
                            html_content = html_content.replace(search_pattern, replacement)
                            print(f"Replaced discrete hex color {old_color} -> {new_color}")
                            modified = True
        
        # If no continuous scale was found, fall back to standard discrete color replacement
        elif not modified:
            hex_color_pattern = r'"(#[0-9a-fA-F]{6})"'
            hex_matches = re.findall(hex_color_pattern, html_content)
            
            if hex_matches:
                print(f"Found hex colors: {hex_matches[:5]}")  # Show first 5
                print(f"Number of new colors available: {len(new_colors)}")
                print(f"New colors: {new_colors}")
                
                # Replace only the first N colors with available theme colors
                for i, new_color in enumerate(new_colors):
                    if i < len(hex_matches):
                        old_color = hex_matches[i]
                        search_pattern = f'"{old_color}"'
                        replacement = f'"{new_color}"'
                        
                        print(f"DEBUG: Looking for pattern: {search_pattern}")
                        print(f"DEBUG: Will replace with: {replacement}")
                        
                        # Count how many times this pattern appears
                        count_before = html_content.count(search_pattern)
                        print(f"DEBUG: Pattern appears {count_before} times in file")
                        
                        if count_before > 0:
                            html_content = html_content.replace(search_pattern, replacement)  # Replace ALL occurrences, not just 1
                            count_after = html_content.count(search_pattern)
                            print(f"DEBUG: Pattern now appears {count_after} times (should be 0 after replacing all {count_before} instances)")
                            
                            # Verify the replacement actually happened
                            replacement_count = html_content.count(replacement)
                            print(f"DEBUG: New color appears {replacement_count} times in file")
                            
                            modified = True
                            print(f"SUCCESS: Replaced {old_color} with {new_color}")
                        else:
                            print(f"WARNING: Pattern {search_pattern} not found in file!")
                            # Show a sample of the file content around where we'd expect colors
                            sample = html_content[:1000]
                            print(f"DEBUG: File sample: {sample}")
                    else:
                        break
                    
        # Last resort: look for specific plotly color properties
        if not modified:
            color_properties = ['fillcolor', 'marker', 'line']
            for prop in color_properties:
                prop_pattern = f'"{prop}".*?"(#[0-9a-fA-F]{{6}})"'
                if re.search(prop_pattern, html_content) and new_colors:
                    html_content = re.sub(prop_pattern, f'"{prop}":"{new_colors[0]}"', html_content, count=1)
                    modified = True
                    print(f"Updated {prop} color to {new_colors[0]}")
                    break
        
        if not modified:
            print(f"No colors found to modify in {html_file_path}")
            return False
        
        # Validate HTML content before writing
        if len(html_content) < 100:  # HTML should be much longer
            print(f"ERROR: HTML content too short ({len(html_content)} chars), not writing to avoid corruption")
            return False
            
        if '<html' not in html_content.lower():
            print(f"ERROR: HTML content doesn't appear to be valid HTML, not writing")
            return False
        
        # Create backup before modifying
        backup_path = html_file_path + '.backup'
        try:
            with open(html_file_path, 'r', encoding='utf-8') as f:
                backup_content = f.read()
            with open(backup_path, 'w', encoding='utf-8') as f:
                f.write(backup_content)
        except Exception as e:
            print(f"Warning: Could not create backup: {e}")
        
        # Write back to file with extensive debugging
        try:
            print(f"DEBUG: About to write {len(html_content)} characters to {html_file_path}")
            
            # Check if file is writable
            if not os.access(os.path.dirname(html_file_path), os.W_OK):
                print(f"ERROR: No write permission to directory {os.path.dirname(html_file_path)}")
                return False
            
            with open(html_file_path, 'w', encoding='utf-8') as f:
                f.write(html_content)
                f.flush()  # Force write to disk
                os.fsync(f.fileno())  # Force OS to write to disk
                
            print(f"DEBUG: File written, now verifying...")
                
            # Verify the file was written correctly
            with open(html_file_path, 'r', encoding='utf-8') as f:
                verify_content = f.read()
                
            print(f"DEBUG: Original content length: {len(html_content)}")
            print(f"DEBUG: Verified content length: {len(verify_content)}")
            
            if len(verify_content) != len(html_content):
                print(f"ERROR: File write verification failed for {html_file_path}")
                print(f"ERROR: Length mismatch - wrote {len(html_content)} but read {len(verify_content)}")
                return False
                
            # Check if colors actually changed by looking for one of the new colors
            if new_colors and new_colors[0] in verify_content:
                print(f"SUCCESS: New color {new_colors[0]} found in written file")
                # CRITICAL: Also check if old colors are gone
                old_colors = ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728']
                old_colors_still_present = [color for color in old_colors if f'"{color}"' in verify_content]
                if old_colors_still_present:
                    print(f"CRITICAL ERROR: Old colors still present in file: {old_colors_still_present}")
                    print(f"This means the modification didn't actually work!")
                    return False
                else:
                    print(f"CONFIRMED: Old colors successfully removed from file")
            else:
                print(f"CRITICAL ERROR: New color {new_colors[0] if new_colors else 'N/A'} NOT found in written file")
                print(f"First 500 chars of written file: {verify_content[:500]}")
                return False
                
            print(f"Successfully modified and verified colors in {html_file_path}")
            
            # Clean up backup
            if os.path.exists(backup_path):
                os.remove(backup_path)
                
            return True
            
        except Exception as e:
            print(f"ERROR: Failed to write HTML file {html_file_path}: {e}")
            # Restore from backup if it exists
            if os.path.exists(backup_path):
                try:
                    with open(backup_path, 'r', encoding='utf-8') as f:
                        backup_content = f.read()
                    with open(html_file_path, 'w', encoding='utf-8') as f:
                        f.write(backup_content)
                    print(f"Restored {html_file_path} from backup after error")
                except Exception as restore_error:
                    print(f"ERROR: Could not restore backup: {restore_error}")
            return False
        
    except Exception as e:
        print(f"Error modifying HTML colors in {html_file_path}: {e}")
        return False

@app.post("/regenerate_plots/{file_uuid}/", tags=["🎨 Theme Management"], summary="Regenerate Plots with Current Theme")
async def regenerate_plots(file_uuid: str):
    """
    **Regenerate all existing plots for a dataset with the current theme.**
    
    This endpoint regenerates QC plots, preprocessing plots, and other visualizations
    using the currently active theme. Useful after changing themes to update existing plots.
    
    **Parameters:**
    - **file_uuid**: str - UUID of the dataset to regenerate plots for
    
    **Returns:**
    ```json
    {
        "message": "Plots regenerated successfully",
        "regenerated_plots": ["qc_plots"],
        "theme_applied": "dark"
    }
    ```
    """
    try:
        # Check if file exists
        dir_path = os.path.join(UPLOAD_FOLDER, file_uuid)
        file_path = os.path.join(dir_path, f"{file_uuid}.h5ad")
        
        if not os.path.exists(file_path):
            raise HTTPException(status_code=404, detail="Dataset not found")
        
        regenerated_plots = []
        current_theme = theme_manager.get_theme()  # Use the correct method
        
        # Get current theme colors for different plot types
        violin_colors = current_theme.plot_types.get("violin_plots", {}).get("colors", ["#1f77b4", "#ff7f0e", "#2ca02c"])
        scatter_colors = current_theme.plot_types.get("scatter_plots", {}).get("colors", ["#e91e63", "#9c27b0", "#673ab7", "#3f51b5", "#2196f3"])
        
        # For PCA and UMAP, get both continuous palette names AND discrete colors
        pca_palette = current_theme.plot_types.get("pca_plots", {}).get("continuous_palette", "viridis")
        umap_palette = current_theme.plot_types.get("umap_plots", {}).get("continuous_palette", "viridis")
        umap_discrete_colors = current_theme.plot_types.get("umap_plots", {}).get("colors", ["#1f77b4", "#ff7f0e", "#2ca02c", "#d62728", "#9467bd"])
        
        # Get elbow plot colors
        elbow_config = current_theme.plot_types.get("elbow_plots", {})
        elbow_colors = [
            elbow_config.get("base_color", "DarkGreen"),
            elbow_config.get("highlight_color", "red")
        ]
        
        # Modify existing plots in qc_plots, preprocess, and embedding directories
        plot_directories = [
            ("qc_plots", os.path.join(dir_path, "qc_plots")),
            ("preprocess", os.path.join(dir_path, "preprocess")),
            ("embedding", os.path.join(dir_path, "embedding"))
        ]
        
        for dir_name, plots_dir in plot_directories:
            if os.path.exists(plots_dir):
                print(f"DEBUG: Found {dir_name} directory: {plots_dir}")
                files_in_dir = os.listdir(plots_dir)
                print(f"DEBUG: Files in {dir_name} directory: {files_in_dir}")
                
                modified_count = 0
                
                # Find all HTML plot files (violin, scatter, PCA, and UMAP plots)
                # Detect violin plots more broadly (QC files are named like 'violin_plot_qc_metrics.html')
                violin_files = [f for f in files_in_dir if f.endswith('.html') and 'violin' in f.lower()]
                pca_files = [f for f in files_in_dir if f.startswith('pca_') and f.endswith('.html')]
                umap_files = [f for f in files_in_dir if f.startswith('umap_') and f.endswith('.html')]
                scatter_files = [
                    f for f in files_in_dir
                    if f.endswith('.html')
                    and 'violin' not in f.lower()
                    and not f.endswith('.out') and not f.endswith('.err')
                    and f not in pca_files and f not in umap_files
                ]
                
                print(f"DEBUG: All files in directory: {files_in_dir}")
                print(f"DEBUG: Files ending with .html: {[f for f in files_in_dir if f.endswith('.html')]}")
                all_plot_files = violin_files + scatter_files + pca_files + umap_files
                print(f"DEBUG: Violin HTML files found: {violin_files}")
                print(f"DEBUG: Scatter HTML files found: {scatter_files}")
                print(f"DEBUG: PCA HTML files found: {pca_files}")
                print(f"DEBUG: UMAP HTML files found: {umap_files}")
                print(f"DEBUG: All plot files to modify: {all_plot_files}")
                
                for filename in all_plot_files:
                    html_file_path = os.path.join(plots_dir, filename)
                    abs_path = os.path.abspath(html_file_path)
                    print(f"DEBUG: Attempting to modify: {html_file_path}")
                    print(f"DEBUG: Absolute path: {abs_path}")
                    print(f"DEBUG: File exists: {os.path.exists(abs_path)}")
                    print(f"DEBUG: File size before: {os.path.getsize(abs_path) if os.path.exists(abs_path) else 'N/A'}")
                    
                    # Determine plot type based on filename
                    if filename in violin_files:
                        file_type = "violin"
                        colors_to_use = violin_colors
                    elif filename == "pca_elbow_plot.html":
                        file_type = "elbow"
                        colors_to_use = elbow_colors
                    elif filename in pca_files:
                        file_type = "pca"
                        # For PCA plots: pass both palette name and backup discrete colors
                        pca_discrete_colors = current_theme.plot_types.get("violin_plots", {}).get("colors", ["#1f77b4", "#ff7f0e", "#2ca02c"])
                        colors_to_use = [pca_palette] + pca_discrete_colors[:10]  # Palette name first, then discrete colors
                    elif filename in umap_files:
                        file_type = "umap"
                        # For UMAP plots: intelligently handle discrete vs continuous
                        if "leiden" in filename.lower():
                            # Discrete UMAP plot (clusters) - use robust discrete palette injection
                            colors_to_use = ["DISCRETE_PALETTE"] + umap_discrete_colors  # Use discrete injection approach
                        else:
                            # Continuous UMAP plot (gene expression, mito, etc.) - use same strategy as PCA plots
                            umap_backup_colors = current_theme.plot_types.get("violin_plots", {}).get("colors", ["#1f77b4", "#ff7f0e", "#2ca02c"])
                            colors_to_use = [umap_palette] + umap_backup_colors[:10]  # Same continuous injection as PCA
                    else:
                        file_type = "scatter"
                        colors_to_use = scatter_colors
                    
                    print(f"DEBUG: Processing {file_type} plot: {filename}")
                    print(f"DEBUG: Using {file_type} colors: {colors_to_use[:3]}...")
                    
                    # Modify colors directly in HTML file
                    if modify_plotly_html_colors_new(html_file_path, colors_to_use, file_uuid):
                        modified_count += 1
                        print(f"Successfully modified colors in {filename}")
                    else:
                        print(f"Failed to modify colors in {filename}")
                
                if modified_count > 0:
                    regenerated_plots.append(dir_name)
                    print(f"Modified {modified_count} plots in {dir_name} with theme: {current_theme.theme_name}")
                else:
                    print(f"No plots were successfully modified in {dir_name}")
            else:
                print(f"DEBUG: Directory does not exist: {plots_dir}")
        
        return {
            "message": "Plots regenerated successfully" if regenerated_plots else "No plots found to regenerate",
            "regenerated_plots": regenerated_plots,
            "theme_applied": theme_manager.current_theme,
            "file_uuid": file_uuid,
            "timestamp": datetime.now().isoformat()
        }
        
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to regenerate plots: {str(e)}")


@app.get("/themes/{theme_name}/preview/", tags=["🎨 Theme Management"], summary="Preview Theme")
async def preview_theme(theme_name: str):
    """
    **Generate a preview visualization of a theme.**
    
    Creates sample plots demonstrating how the theme will look,
    including color palettes, fonts, and layout settings.
    
    **Parameters:**
    - **theme_name**: str - Name of theme to preview
    
    **Returns:**
    HTML preview plots and color swatches for theme evaluation.
    """
    try:
        if theme_name not in theme_manager.list_themes():
            raise HTTPException(status_code=404, detail=f"Theme '{theme_name}' not found")
        
        theme = theme_manager.get_theme(theme_name)
        preview = create_theme_preview(theme)
        
        # Get color palette from theme structure
        color_palette = []
        if hasattr(theme, 'plot_types') and 'violin_plots' in theme.plot_types:
            color_palette = theme.plot_types['violin_plots'].get('colors', ['#1f77b4', '#ff7f0e', '#2ca02c'])
        elif hasattr(theme, 'colors') and 'primary_palette' in theme.colors:
            color_palette = theme.colors['primary_palette']
        else:
            color_palette = ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728']
            
        font_family = theme.global_settings.get('font_family', 'Arial, sans-serif') if hasattr(theme, 'global_settings') else 'Arial, sans-serif'

        return {
            "theme_name": theme_name,
            "preview": preview,
            "color_palette": color_palette,
            "font_family": font_family
        }
    
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to generate preview: {str(e)}")


@app.get("/themes/plot-types/", tags=["🎨 Theme Management"], summary="Get All Plot Type Configurations")
async def get_plot_type_configurations():
    """
    Get configuration options for all plot types in the current theme.
    
    Returns detailed settings for each plot type including colors, sizes, templates, etc.
    """
    try:
        current_theme = get_current_theme()
        plot_configs = {}
        
        for plot_type in current_theme.list_plot_types():
            config = current_theme.get_plot_config(plot_type)
            plot_configs[plot_type] = config
            
        return {
            "current_theme": current_theme.theme_name,
            "plot_types": plot_configs,
            "available_plot_types": current_theme.list_plot_types()
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to get plot configurations: {str(e)}")


@app.put("/themes/plot-types/{plot_type}/", tags=["🎨 Theme Management"], summary="Update Plot Type Configuration")
async def update_plot_type_configuration(plot_type: str, config_update: dict):
    """
    Update configuration for a specific plot type.
    
    Allows granular customization of individual plot types within the current theme.
    
    **Parameters:**
    - plot_type: The type of plot to update (violin_plots, scatter_plots, umap_plots, etc.)
    - config_update: Dictionary with configuration updates
    
    **Example Request:**
    ```json
    {
        "colors": ["#ff0000", "#00ff00", "#0000ff"],
        "marker_size": 6,
        "opacity": 0.8
    }
    ```
    """
    try:
        current_theme = get_current_theme()
        
        # Check if current theme is valid
        if not current_theme:
            raise HTTPException(
                status_code=500, 
                detail="No current theme is set. Please set a theme first using /themes/current/{theme_name}/"
            )
        
        # Get available plot types for debugging
        try:
            available_types = current_theme.list_plot_types()
            if not available_types:
                raise HTTPException(
                    status_code=500,
                    detail=f"Current theme '{getattr(current_theme, 'theme_name', 'unknown')}' has no plot types configured"
                )
        except Exception as list_error:
            raise HTTPException(
                status_code=500,
                detail=f"Error listing plot types from theme: {str(list_error)}"
            )
        
        # Validate plot type
        if plot_type not in available_types:
            raise HTTPException(
                status_code=404, 
                detail=f"Plot type '{plot_type}' not found. Available types: {available_types}"
            )
        
        # Update the plot type configuration
        try:
            current_theme.update_plot_config(plot_type, config_update)
        except Exception as update_error:
            raise HTTPException(
                status_code=500,
                detail=f"Error updating plot configuration: {str(update_error)}"
            )
        
        # Get updated configuration
        updated_config = current_theme.get_plot_config(plot_type)
        
        return {
            "message": f"Plot type '{plot_type}' updated successfully",
            "plot_type": plot_type,
            "updated_config": updated_config
        }
        
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to update plot configuration: {str(e)}")


@app.get("/themes/plot-types/{plot_type}/", tags=["🎨 Theme Management"], summary="Get Specific Plot Type Configuration")
async def get_plot_type_configuration(plot_type: str):
    """
    Get configuration for a specific plot type.
    
    Returns all customizable settings for the specified plot type.
    """
    try:
        current_theme = get_current_theme()
        
        # Validate plot type
        if plot_type not in current_theme.list_plot_types():
            raise HTTPException(
                status_code=404,
                detail=f"Plot type '{plot_type}' not found. Available types: {current_theme.list_plot_types()}"
            )
        
        config = current_theme.get_plot_config(plot_type)
        
        return {
            "plot_type": plot_type,
            "configuration": config,
            "theme_name": current_theme.theme_name
        }
        
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to get plot configuration: {str(e)}")


def _get_theme_description(theme_name: str) -> str:
    """Get user-friendly description for a theme."""
    descriptions = {
        "default": "Clean scientific theme with professional blue palette",
        "dark": "Dark mode theme for low-light environments",
        "colorblind_friendly": "Accessible theme optimized for colorblind users",
        "high_contrast": "High contrast theme for accessibility",
        "publication": "Black and white theme perfect for scientific publications",
        "vibrant": "Bright and colorful theme for presentations"
    }
    return descriptions.get(theme_name, "Custom user-defined theme")


def _get_theme_category(theme_name: str) -> str:
    """Get category for theme organization."""
    categories = {
        "default": "scientific",
        "dark": "alternative",
        "colorblind_friendly": "accessibility",
        "high_contrast": "accessibility", 
        "publication": "scientific",
        "vibrant": "presentation"
    }
    return categories.get(theme_name, "custom")


