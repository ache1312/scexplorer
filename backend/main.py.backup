@app.get("/themes/", tags=["🎨 Theme Management"], summary="List All Available Themes")
async def list_themes():
    """
    **Get all available plot themes for visualization customization.**
    
    Returns a list of all predefined and custom themes available in the system.
    Each theme includes a preview and description of its visual characteristics.
    
    **Returns:**
    ```json
    {
        "themes": [
            {
                "name": "default",
                "description": "Clean scientific theme with blue palette",
                "category": "scientific",
                "preview_colors": ["#1f77b4", "#ff7f0e", "#2ca02c"]
            }
        ],
        "current_theme": "default"
    }
    ```
    
    **HTTP Status Codes:**
    - `200`: Successfully retrieved theme list
    - `500`: Server error
    
    **Use Cases:**
    - Theme selection in UI dropdowns
    - Preview themes before applying
    - Discover accessibility themes
    """
    try:
        theme_names = theme_manager.list_themes()
        theme_info = []
        
        for name in theme_names:
            theme = theme_manager.get_theme(name)
            
            # Get colors from plot_types instead of colors dict
            preview_colors = []
            if hasattr(theme, 'plot_types') and 'violin_plots' in theme.plot_types:
                preview_colors = theme.plot_types['violin_plots'].get('colors', ['#1f77b4', '#ff7f0e', '#2ca02c'])
            elif hasattr(theme, 'colors') and 'primary_palette' in theme.colors:
                preview_colors = theme.colors['primary_palette']
            else:
                preview_colors = ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728']
                
            background_color = theme.global_settings.get('background_color', '#ffffff') if hasattr(theme, 'global_settings') else '#ffffff'
            
            theme_info.append({
                "name": name,
                "description": _get_theme_description(name),
                "category": _get_theme_category(name),
                "preview_colors": preview_colors[:5],
                "background_color": background_color,
                "is_accessible": hasattr(theme, 'accessibility') and any(theme.accessibility.values()) if hasattr(theme, 'accessibility') else False
            })
        
        return {
            "themes": theme_info,
            "current_theme": theme_manager.current_theme,
            "total_themes": len(theme_names)
        }
    
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to retrieve themes: {str(e)}")


