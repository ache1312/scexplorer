UPLOAD_FOLDER = "uploads"
DATABASE = "tasks.db"

def update_config(uuid: str, new_params: dict):
    """
    Lee el config.txt en uploads/{uuid}/config.txt si existe,
    mezcla los parámetros con new_params y vuelve a escribirlo.
    """
    cfg_path = os.path.join(UPLOAD_FOLDER, uuid, "config.txt")
    config = {}
    # 1) si ya existe, léelo
    if os.path.exists(cfg_path):
        with open(cfg_path, "r") as f:
            for line in f:
                if "=" in line:
                    k, v = line.strip().split("=", 1)
                    config[k] = v
    # 2) sobrescribe/añade
    for k, v in new_params.items():
        config[k] = str(v)
    # 3) escribe de nuevo
    with open(cfg_path, "w") as f:
        for k, v in config.items():
            f.write(f"{k}={v}\n")

def get_db():
    conn = sqlite3.connect(DATABASE)
    return conn

@app.on_event("startup")
def startup():
    if not os.path.exists(UPLOAD_FOLDER):
        os.makedirs(UPLOAD_FOLDER)

    conn = get_db()
    cursor = conn.cursor()

    # Create tasks table
    cursor.execute("""
    CREATE TABLE IF NOT EXISTS tasks (
        id INTEGER PRIMARY KEY,
        uuid TEXT NOT NULL UNIQUE,
        file_path TEXT,
        species TEXT,
        email TEXT,
        analysisName TEXT,  
        created_at TEXT NOT NULL
    );
    """)

    # Create processing_info table with the new columns
    cursor.execute("""
    CREATE TABLE IF NOT EXISTS processing_info (
        id INTEGER PRIMARY KEY,
        task_id INTEGER,
        cells_number_pre_processing INTEGER,
        genes_number_pre_processing INTEGER,
        cells_number_post_processing INTEGER,
        genes_number_post_processing INTEGER,
        min_genes INTEGER,
        min_cells INTEGER,
        mito_threshold REAL, 
        n_neighbors INTEGER DEFAULT NULL,
        n_pcs INTEGER DEFAULT NULL,
        clusters INTEGER DEFAULT NULL,
        FOREIGN KEY(task_id) REFERENCES tasks(id)
    );
    """)
        
    cursor.execute("""
    CREATE TABLE IF NOT EXISTS dea_results (
        id INTEGER PRIMARY KEY,
        task_id INTEGER,
        dotplot_1_path TEXT,
        dotplot_2_path TEXT,
        FOREIGN KEY(task_id) REFERENCES tasks(id)
    );
    """)
    conn.commit()
    conn.close()
    
